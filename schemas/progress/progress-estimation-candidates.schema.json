{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://focusmate.local/schemas/progress/progress-estimation-candidates.schema.json",
  "title": "ProgressEstimationCandidates",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "findings"
  ],
  "properties": {
    "findings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "subject",
          "reason",
          "evidenceRefs",
          "uncertainties"
        ],
        "properties": {
          "kind": {
            "enum": [
              "progressing",
              "no_material_change",
              "regression_candidate",
              "blocked_candidate",
              "verification_candidate",
              "unknown"
            ]
          },
          "subject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1600
          },
          "evidenceRefs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "uncertainties": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "verification": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "criterionId",
              "evidenceType",
              "materialRefs"
            ],
            "properties": {
              "criterionId": {
                "type": "string",
                "minLength": 1
              },
              "evidenceType": {
                "enum": [
                  "confirmedProblemFeature",
                  "evaluatedUserExplanation",
                  "complexityCheck",
                  "codeStructureCheck",
                  "compileResult",
                  "runResult",
                  "publicSampleRunResult",
                  "targetedRunResult",
                  "ojResult"
                ]
              },
              "materialRefs": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "verification_candidate"
                }
              }
            },
            "then": {
              "required": [
                "verification"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "verification"
                ]
              }
            }
          }
        ]
      }
    }
  }
}
