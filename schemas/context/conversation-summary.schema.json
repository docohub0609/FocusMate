{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://focusmate.local/schemas/context/conversation-summary.schema.json",
  "title": "ConversationSummary",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "goalContext": {
      "$ref": "https://focusmate.local/schemas/common/goal-context.schema.json"
    },
    "promptVersion": {
      "type": "string",
      "minLength": 1
    },
    "sourceRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sourceHashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "text",
          "sourceRefs",
          "quotes"
        ],
        "properties": {
          "kind": {
            "enum": [
              "userStatement",
              "correction",
              "hypothesis",
              "unresolved"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "sourceRefs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "quotes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ref",
                "text"
              ],
              "properties": {
                "ref": {
                  "type": "string"
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1200
                }
              }
            }
          }
        }
      }
    },
    "semanticStatus": {
      "const": "notVerified"
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "summaryId": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "focusHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "goalContext",
    "promptVersion",
    "sourceRefs",
    "sourceHashes",
    "items",
    "semanticStatus",
    "model",
    "contentHash",
    "summaryId",
    "createdAt"
  ]
}
