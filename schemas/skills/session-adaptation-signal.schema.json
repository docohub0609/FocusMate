{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://focusmate.local/schemas/skills/session-adaptation-signal.schema.json",
  "title": "SessionAdaptationSignal",
  "type": "object",
  "required": [
    "eventId",
    "episodeId",
    "kind",
    "status",
    "sourceRef",
    "evidenceRefs",
    "reason"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1
    },
    "episodeId": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "feedback",
        "verification"
      ]
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "sourceRef": {
      "type": "string",
      "minLength": 1
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "supersedes": {
      "type": "string",
      "minLength": 1
    },
    "verifierRef": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "feedback"
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "enum": [
              "notHelpful",
              "misunderstood",
              "other",
              "uncertain"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "status": {
            "enum": [
              "supports",
              "notSupported",
              "uncertain"
            ]
          }
        }
      }
    }
  ]
}
