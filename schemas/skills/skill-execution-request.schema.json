{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "goalContext",
    "skillRef",
    "inputs",
    "dialogue",
    "hintLevel"
  ],
  "$defs": {
    "evidence": {
      "type": "object",
      "required": [
        "ref",
        "text"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "goalContext": {
      "$ref": "https://focusmate.local/schemas/common/goal-context.schema.json"
    },
    "skillRef": {
      "type": "object",
      "required": [
        "skillId",
        "skillVersion",
        "skillHash"
      ],
      "properties": {
        "skillId": {
          "$ref": "https://focusmate.local/schemas/common/definitions.schema.json#/$defs/nonEmptyString"
        },
        "skillVersion": {
          "$ref": "https://focusmate.local/schemas/common/definitions.schema.json#/$defs/version"
        },
        "skillHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "inputs": {
      "type": "object",
      "required": [
        "userRequest",
        "goalRequirement",
        "problemFacts",
        "code",
        "runEvidence"
      ],
      "properties": {
        "userRequest": {
          "$ref": "#/$defs/evidence"
        },
        "goalRequirement": {
          "$ref": "#/$defs/evidence"
        },
        "problemFacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "code": {
          "type": "object",
          "required": [
            "snapshotRef",
            "text"
          ],
          "properties": {
            "snapshotRef": {
              "type": "string",
              "minLength": 1
            },
            "text": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "runEvidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "ref",
              "text",
              "codeSnapshotRef"
            ],
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "codeSnapshotRef": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "hintLevel": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "dialogue": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "role",
          "text"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "user",
              "assistant"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://focusmate.local/schemas/skills/skill-execution-request.schema.json",
  "title": "SkillExecutionRequest"
}
