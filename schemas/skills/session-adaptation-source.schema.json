{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://focusmate.local/schemas/skills/session-adaptation-source.schema.json",
  "title": "SessionAdaptationSource",
  "type": "object",
  "required": [
    "sessionId",
    "goalContext",
    "sourceId",
    "kind"
  ],
  "properties": {
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "goalContext": {
      "$ref": "https://focusmate.local/schemas/common/goal-context.schema.json"
    },
    "sourceId": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "trigger",
        "invocation",
        "action",
        "code",
        "feedback",
        "verifier",
        "process"
      ]
    },
    "evidenceType": {
      "enum": [
        "fact",
        "hypothesis"
      ]
    },
    "skillRef": {
      "type": "object",
      "required": [
        "skillId",
        "skillVersion",
        "skillHash"
      ],
      "properties": {
        "skillId": {
          "type": "string",
          "minLength": 1
        },
        "skillVersion": {
          "type": "integer",
          "minimum": 1
        },
        "skillHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "sectionIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "actionId": {
      "type": "string",
      "minLength": 1
    },
    "invocationId": {
      "type": "string",
      "minLength": 1
    },
    "actionType": {
      "type": "string",
      "minLength": 1
    },
    "hintLevel": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "codeSnapshotRef": {
      "type": "string",
      "minLength": 1
    },
    "previousCodeSnapshotRef": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "processEvidenceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "trigger"
          }
        }
      },
      "then": {
        "required": [
          "evidenceType"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "invocation"
          }
        }
      },
      "then": {
        "required": [
          "skillRef",
          "sectionIds",
          "codeSnapshotRef"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "action"
          }
        }
      },
      "then": {
        "required": [
          "invocationId",
          "actionType",
          "hintLevel",
          "codeSnapshotRef"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "feedback"
          }
        }
      },
      "then": {
        "required": [
          "actionId",
          "status"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "process"
          }
        }
      },
      "then": {
        "required": [
          "actionId",
          "invocationId",
          "codeSnapshotRef"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "verifier"
          }
        }
      },
      "then": {
        "required": [
          "actionId",
          "invocationId",
          "codeSnapshotRef",
          "status",
          "processEvidenceRefs"
        ]
      }
    }
  ]
}
