{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://focusmate.local/schemas/problem/problem-features.schema.json",
  "title": "ProblemFeatures",
  "$defs": {
    "evidence": {
      "type": "object",
      "required": [
        "sourceField",
        "sourcePath",
        "sourceText"
      ],
      "properties": {
        "evidenceId": {
          "type": "string",
          "minLength": 1
        },
        "sourceField": {
          "enum": [
            "statement",
            "inputSpec",
            "outputSpec",
            "constraints",
            "examples"
          ]
        },
        "sourcePath": {
          "$ref": "https://focusmate.local/schemas/common/definitions.schema.json#/$defs/nonEmptyString"
        },
        "sourceText": {
          "$ref": "https://focusmate.local/schemas/common/definitions.schema.json#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "required": [
        "status",
        "issue",
        "message",
        "allowedActions"
      ],
      "properties": {
        "status": {
          "const": "required"
        },
        "issue": {
          "enum": [
            "locallyUnverifiable",
            "evidenceMismatch",
            "evidenceContextMismatch",
            "hypothesis",
            "unknown",
            "conflict",
            "semanticContradiction",
            "semanticInsufficient",
            "semanticReviewUnavailable"
          ]
        },
        "message": {
          "$ref": "https://focusmate.local/schemas/common/definitions.schema.json#/$defs/nonEmptyString"
        },
        "allowedActions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "editFeature",
              "confirmFeature",
              "editProblem",
              "removeFeature"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "llmGenerated",
            "humanEdited",
            "humanCreated"
          ]
        },
        "basedOnFeatureSetId": {
          "$ref": "https://focusmate.local/schemas/common/definitions.schema.json#/$defs/nonEmptyString"
        },
        "confirmedAt": {
          "$ref": "https://focusmate.local/schemas/common/definitions.schema.json#/$defs/timestamp"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "humanEdited"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "basedOnFeatureSetId",
              "confirmedAt"
            ]
          },
          "else": {
            "not": {
              "required": [
                "basedOnFeatureSetId"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "humanCreated"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "confirmedAt"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "jsonValue": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "array"
        },
        {
          "type": "object"
        }
      ]
    },
    "candidate": {
      "type": "object",
      "required": [
        "value",
        "evidence"
      ],
      "properties": {
        "value": {
          "$ref": "#/$defs/jsonValue"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      },
      "additionalProperties": false
    },
    "feature": {
      "type": "object",
      "required": [
        "featureKey",
        "category",
        "status",
        "reason",
        "evidence"
      ],
      "properties": {
        "featureKey": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9.]*$"
        },
        "category": {
          "enum": [
            "dataScale",
            "inputStructure",
            "outputStructure",
            "resourceConstraint",
            "domainTag"
          ]
        },
        "status": {
          "enum": [
            "confirmed",
            "hypothesis",
            "unknown",
            "conflict"
          ]
        },
        "value": {
          "$ref": "#/$defs/jsonValue"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reason": {
          "$ref": "https://focusmate.local/schemas/common/definitions.schema.json#/$defs/nonEmptyString"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "review": {
          "$ref": "#/$defs/review"
        },
        "candidates": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/candidate"
          }
        },
        "presentation": {
          "type": "object",
          "required": [
            "title",
            "labels"
          ],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "labels": {
              "type": "object",
              "maxProperties": 512,
              "additionalProperties": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            }
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "confirmed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "value",
              "confidence"
            ],
            "properties": {
              "confidence": {
                "const": 1
              },
              "evidence": {
                "minItems": 1
              }
            },
            "not": {
              "required": [
                "candidates"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "hypothesis"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "value",
              "confidence"
            ],
            "properties": {
              "confidence": {
                "exclusiveMinimum": 0,
                "exclusiveMaximum": 1
              },
              "evidence": {
                "minItems": 1
              }
            },
            "not": {
              "required": [
                "candidates"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "unknown"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "value"
                  ]
                },
                {
                  "required": [
                    "confidence"
                  ]
                },
                {
                  "required": [
                    "candidates"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "conflict"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "candidates"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "value"
                  ]
                },
                {
                  "required": [
                    "confidence"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "category": {
                "const": "domainTag"
              },
              "status": {
                "enum": [
                  "confirmed",
                  "hypothesis"
                ]
              }
            },
            "required": [
              "category",
              "status"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "enum": [
                  "array",
                  "string",
                  "matrix",
                  "linkedList",
                  "stack",
                  "queue",
                  "tree",
                  "graph",
                  "set",
                  "map",
                  "number",
                  "geometry",
                  "interval",
                  "sequence",
                  "grid",
                  "operations",
                  "booleanOutput"
                ]
              }
            }
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "featureSetId",
    "schemaVersion",
    "createdAt",
    "problemRef",
    "problemContentHash",
    "status",
    "features"
  ],
  "properties": {
    "featureSetId": {
      "$ref": "https://focusmate.local/schemas/common/definitions.schema.json#/$defs/nonEmptyString"
    },
    "schemaVersion": {
      "$ref": "https://focusmate.local/schemas/common/definitions.schema.json#/$defs/schemaVersion"
    },
    "createdAt": {
      "$ref": "https://focusmate.local/schemas/common/definitions.schema.json#/$defs/timestamp"
    },
    "problemRef": {
      "$ref": "https://focusmate.local/schemas/common/definitions.schema.json#/$defs/problemRef"
    },
    "problemContentHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "extractor": {
      "type": "object",
      "required": [
        "provider",
        "model",
        "promptVersion",
        "providerResponseId"
      ],
      "properties": {
        "provider": {
          "const": "deepseek"
        },
        "model": {
          "$ref": "https://focusmate.local/schemas/common/definitions.schema.json#/$defs/nonEmptyString"
        },
        "promptVersion": {
          "enum": [
            "problem-features-v1",
            "problem-features-evidence-refs-v2",
            "problem-features-evidence-refs-v3",
            "problem-features-io-proposal-v4", "problem-features-io-proposal-v5", "problem-features-io-proposal-v6", "problem-features-io-proposal-v7"
          ]
        },
        "providerResponseId": {
          "$ref": "https://focusmate.local/schemas/common/definitions.schema.json#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "semanticReview": {
      "$ref": "https://focusmate.local/schemas/problem/problem-feature-review-result.schema.json"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "status": {
      "enum": [
        "complete",
        "partial",
        "reviewRequired"
      ]
    },
    "features": {
      "type": "array",
      "minItems": 5,
      "items": {
        "$ref": "#/$defs/feature"
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "category": {
                "const": "dataScale"
              }
            },
            "required": [
              "category"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "category": {
                "const": "inputStructure"
              }
            },
            "required": [
              "category"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "category": {
                "const": "outputStructure"
              }
            },
            "required": [
              "category"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "category": {
                "const": "resourceConstraint"
              }
            },
            "required": [
              "category"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "category": {
                "const": "domainTag"
              }
            },
            "required": [
              "category"
            ]
          }
        }
      ]
    },
    "ioProposal": {
      "type": "object",
      "required": [
        "suggestion",
        "original"
      ],
      "properties": {
        "suggestion": {
          "$ref": "problem-feature-candidates.schema.json#/$defs/ioProposal"
        },
        "original": {
          "type": "object",
          "required": [
            "inputSpec",
            "outputSpec",
            "examples"
          ],
          "properties": {
            "inputSpec": {
              "type": "string"
            },
            "outputSpec": {
              "type": "string"
            },
            "examples": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "ioProposalDecision": {
      "const": "keepOriginal"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "provenance": {
            "properties": {
              "type": {
                "const": "humanCreated"
              }
            },
            "required": [
              "type"
            ]
          }
        },
        "required": [
          "provenance"
        ]
      },
      "then": {
        "not": {
          "required": [
            "extractor"
          ]
        }
      },
      "else": {
        "required": [
          "extractor"
        ]
      }
    }
  ],
  "additionalProperties": false,
  "examples": [
    {
      "featureSetId": "features-001",
      "schemaVersion": "1.0.0",
      "createdAt": "2026-08-15T10:01:00Z",
      "problemContentHash": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "problemRef": {
        "problemId": "problem-001",
        "problemVersion": 1
      },
      "extractor": {
        "provider": "deepseek",
        "model": "deepseek-v4-flash",
        "promptVersion": "problem-features-v1",
        "providerResponseId": "response-001"
      },
      "status": "partial",
      "features": [
        {
          "featureKey": "dataScale.n",
          "category": "dataScale",
          "status": "confirmed",
          "value": {
            "variable": "n",
            "minimum": 1,
            "maximum": 100000
          },
          "confidence": 1,
          "reason": "The bounds are explicit.",
          "evidence": [
            {
              "sourceField": "constraints",
              "sourcePath": "constraints",
              "sourceText": "1 <= n <= 100000"
            }
          ]
        },
        {
          "featureKey": "input.primary",
          "category": "inputStructure",
          "status": "confirmed",
          "value": {
            "kind": "integerSequence",
            "lengthVariable": "n"
          },
          "confidence": 1,
          "reason": "The input specification is explicit.",
          "evidence": [
            {
              "sourceField": "inputSpec",
              "sourcePath": "inputSpec",
              "sourceText": "The second line contains n integers"
            }
          ]
        },
        {
          "featureKey": "output.primary",
          "category": "outputStructure",
          "status": "confirmed",
          "value": {
            "valueCount": 2,
            "valueType": "integer",
            "meanings": [
              "leftBoundary",
              "rightBoundary"
            ]
          },
          "confidence": 1,
          "reason": "The output specification is explicit.",
          "evidence": [
            {
              "sourceField": "outputSpec",
              "sourcePath": "outputSpec",
              "sourceText": "Output two integers: the left and right boundaries"
            }
          ]
        },
        {
          "featureKey": "resource.timeLimit",
          "category": "resourceConstraint",
          "status": "unknown",
          "reason": "No time limit is supplied.",
          "evidence": []
        },
        {
          "featureKey": "domain.array",
          "category": "domainTag",
          "status": "confirmed",
          "value": "array",
          "confidence": 1,
          "reason": "The statement names an integer array.",
          "evidence": [
            {
              "sourceField": "statement",
              "sourcePath": "statement",
              "sourceText": "Given an integer array"
            }
          ]
        }
      ]
    }
  ]
}
