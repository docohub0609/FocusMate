{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://focusmate.local/schemas/problem/problem-feature-candidates.schema.json",
  "title": "ProblemFeatureCandidates",
  "$defs": {
    "jsonValue": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "array"
        },
        {
          "type": "object"
        }
      ]
    },
    "candidate": {
      "type": "object",
      "required": [
        "value",
        "evidenceRefs"
      ],
      "properties": {
        "value": {
          "$ref": "#/$defs/jsonValue"
        },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "feature": {
      "type": "object",
      "required": [
        "featureKey",
        "category",
        "status",
        "reason",
        "evidenceRefs"
      ],
      "properties": {
        "featureKey": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9.]*$"
        },
        "category": {
          "enum": [
            "dataScale",
            "inputStructure",
            "outputStructure",
            "resourceConstraint",
            "domainTag"
          ]
        },
        "status": {
          "enum": [
            "confirmed",
            "hypothesis",
            "unknown",
            "conflict"
          ]
        },
        "value": {
          "$ref": "#/$defs/jsonValue"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "candidates": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/candidate"
          }
        },
        "presentation": {
          "type": "object",
          "required": [
            "title",
            "labels"
          ],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "labels": {
              "type": "object",
              "maxProperties": 512,
              "additionalProperties": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            }
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "confirmed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "value",
              "confidence"
            ],
            "properties": {
              "confidence": {
                "const": 1
              },
              "evidenceRefs": {
                "minItems": 1
              }
            },
            "not": {
              "required": [
                "candidates"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "hypothesis"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "value",
              "confidence"
            ],
            "properties": {
              "confidence": {
                "exclusiveMinimum": 0,
                "exclusiveMaximum": 1
              },
              "evidenceRefs": {
                "minItems": 1
              }
            },
            "not": {
              "required": [
                "candidates"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "unknown"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "evidenceRefs": {
                "maxItems": 0
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "value"
                  ]
                },
                {
                  "required": [
                    "confidence"
                  ]
                },
                {
                  "required": [
                    "candidates"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "conflict"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "candidates"
            ],
            "properties": {
              "evidenceRefs": {
                "maxItems": 0
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "value"
                  ]
                },
                {
                  "required": [
                    "confidence"
                  ]
                }
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "ioProposal": {
      "type": "object",
      "required": [
        "reason",
        "inputSpec",
        "outputSpec",
        "examples",
        "evidenceRefs"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "inputSpec": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "outputSpec": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "examples": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": [
              "input",
              "output"
            ],
            "properties": {
              "input": {
                "type": "string",
                "maxLength": 10000
              },
              "output": {
                "type": "string",
                "maxLength": 10000
              }
            },
            "additionalProperties": false
          }
        },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "features"
  ],
  "properties": {
    "features": {
      "type": "array",
      "minItems": 5,
      "items": {
        "$ref": "#/$defs/feature"
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "category": {
                "const": "dataScale"
              }
            },
            "required": [
              "category"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "category": {
                "const": "inputStructure"
              }
            },
            "required": [
              "category"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "category": {
                "const": "outputStructure"
              }
            },
            "required": [
              "category"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "category": {
                "const": "resourceConstraint"
              }
            },
            "required": [
              "category"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "category": {
                "const": "domainTag"
              }
            },
            "required": [
              "category"
            ]
          }
        }
      ]
    },
    "ioProposal": {
      "$ref": "#/$defs/ioProposal"
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "features": [
        {
          "featureKey": "dataScale.primary",
          "category": "dataScale",
          "status": "unknown",
          "reason": "No explicit scale is present.",
          "evidenceRefs": []
        },
        {
          "featureKey": "input.primary",
          "category": "inputStructure",
          "status": "unknown",
          "reason": "The input structure is ambiguous.",
          "evidenceRefs": []
        },
        {
          "featureKey": "output.primary",
          "category": "outputStructure",
          "status": "unknown",
          "reason": "The output structure is ambiguous.",
          "evidenceRefs": []
        },
        {
          "featureKey": "resource.primary",
          "category": "resourceConstraint",
          "status": "unknown",
          "reason": "No resource limit is present.",
          "evidenceRefs": []
        },
        {
          "featureKey": "domain.primary",
          "category": "domainTag",
          "status": "unknown",
          "reason": "No domain structure is explicit.",
          "evidenceRefs": []
        }
      ]
    }
  ]
}
