{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://focusmate.local/schemas/problem/feature-extraction-job.schema.json",
  "title": "FeatureExtractionJob",
  "type": "object",
  "required": [
    "jobId",
    "request",
    "status",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "jobId": {
      "type": "string",
      "minLength": 1
    },
    "request": {
      "$ref": "https://focusmate.local/schemas/problem/feature-extraction-job-request.schema.json"
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "interrupted",
        "stale"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "featureSetId": {
      "type": "string"
    },
    "failureCode": {
      "type": "string"
    },
    "failureDetails": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "message"
        ],
        "properties": {
          "field": {
            "type": "string",
            "maxLength": 160
          },
          "message": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    }
  },
  "additionalProperties": false
}
