{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://focusmate.local/schemas/problem/problem-intake-request.schema.json",
  "title": "ProblemIntakeRequest",
  "type": "object",
  "required": ["statement", "inputSpec", "outputSpec", "constraints", "examples", "language", "ioMode"],
  "properties": {
    "title": {"type": "string", "maxLength": 120},
    "statement": {"type": "string", "pattern": "\\S"},
    "inputSpec": {"type": "string", "pattern": "\\S"},
    "outputSpec": {"type": "string", "pattern": "\\S"},
    "constraints": {"type": "string", "pattern": "\\S"},
    "examples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["input", "output"],
        "properties": {
          "input": {"type": "string"},
          "output": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "language": {"const": "python3"},
    "ioMode": {"const": "standardInputOutput"}
  },
  "additionalProperties": false,
  "examples": [{
    "statement": "Return the sum of two integers.",
    "inputSpec": "Two integers on one line.",
    "outputSpec": "Their sum.",
    "constraints": "-1000 <= a,b <= 1000",
    "examples": [{"input": "1 2\n", "output": "3\n"}],
    "language": "python3",
    "ioMode": "standardInputOutput"
  }]
}
